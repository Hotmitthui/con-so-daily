{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "con-so-daily",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tu_ve_daily",
      "database_id": "4ba8f2b3-8a52-472f-893b-b62a446b41ff"
    }
  ],
  "observability": {
    "enabled": true
  }
}
